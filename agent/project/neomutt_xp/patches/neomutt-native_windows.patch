+enum ImapPendingFlagBits
+{
+  IPF_READ = 1U << 0,
+  IPF_OLD = 1U << 1,
+  IPF_FLAGGED = 1U << 2,
+  IPF_REPLIED = 1U << 3,
+  IPF_DELETED = 1U << 4,
+};
+
+static int pending_flags_compare(const void *a, const void *b)
+{
+  const struct ImapPendingFlags *left = a;
+  const struct ImapPendingFlags *right = b;
+  return (left->uid > right->uid) - (left->uid < right->uid);
+}
+
+/** Save only local per-flag deltas before a reconnect can invalidate headers. */
+void imap_save_pending_flags(struct Mailbox *m)
+{
+  struct ImapMboxData *mdata = imap_mdata_get(m);
+  if (!mdata || !mdata->uidvalidity || !m->changed)
+    return;
+  if (ARRAY_EMPTY(&mdata->pending_flags))
+    mdata->pending_uidvalidity = mdata->uidvalidity;
+  if (mdata->pending_uidvalidity != mdata->uidvalidity)
+    return;
+
+  const size_t previous_count = ARRAY_SIZE(&mdata->pending_flags);
+  for (int i = 0; i < m->msg_count; i++)
+  {
+    struct Email *e = m->emails[i];
+    if (!e || !e->changed)
+      continue;
+    struct ImapEmailData *edata = imap_edata_get(e);
+    if (!edata)
+      continue;
+    struct ImapPendingFlags pending = { .uid = edata->uid, .purge = e->purge };
+    pending.mask = ((e->read != edata->read) ? IPF_READ : 0) |
+                   ((e->old != edata->old) ? IPF_OLD : 0) |
+                   ((e->flagged != edata->flagged) ? IPF_FLAGGED : 0) |
+                   ((e->replied != edata->replied) ? IPF_REPLIED : 0) |
+                   ((e->deleted != edata->deleted) ? IPF_DELETED : 0);
+    pending.values = (e->read ? IPF_READ : 0) | (e->old ? IPF_OLD : 0) |
+                     (e->flagged ? IPF_FLAGGED : 0) | (e->replied ? IPF_REPLIED : 0) |
+                     (e->deleted ? IPF_DELETED : 0);
+    struct ImapPendingFlags *existing = previous_count ?
+        bsearch(&pending, mdata->pending_flags.entries, previous_count,
+                sizeof(pending), pending_flags_compare) : NULL;
+    if (existing)
+      *existing = pending;
+    else if (pending.mask)
+      ARRAY_ADD(&mdata->pending_flags, pending);
+  }
+  if (ARRAY_SIZE(&mdata->pending_flags) > 1)
+    qsort(mdata->pending_flags.entries, ARRAY_SIZE(&mdata->pending_flags),
+          sizeof(struct ImapPendingFlags), pending_flags_compare);
+}
+
+/** Replay deltas against fresh server state; never match by sequence number. */
+static void imap_restore_pending_flags(struct Mailbox *m)
+{
+  struct ImapMboxData *mdata = imap_mdata_get(m);
+  if (!mdata || (mdata->pending_uidvalidity != mdata->uidvalidity))
+    return;
+  struct ImapPendingFlags *pending = NULL;
+  ARRAY_FOREACH(pending, &mdata->pending_flags)
+  {
+    struct Email *e = mutt_hash_int_find(mdata->uid_hash, pending->uid);
+    if (!e)
+      continue;
+    if (pending->mask & IPF_READ)
+      mutt_set_flag(m, e, MUTT_READ, (pending->values & IPF_READ) != 0, true);
+    if (pending->mask & IPF_OLD)
+      mutt_set_flag(m, e, MUTT_OLD, (pending->values & IPF_OLD) != 0, true);
+    if (pending->mask & IPF_FLAGGED)
+      mutt_set_flag(m, e, MUTT_FLAG, (pending->values & IPF_FLAGGED) != 0, true);
+    if (pending->mask & IPF_REPLIED)
+      mutt_set_flag(m, e, MUTT_REPLIED, (pending->values & IPF_REPLIED) != 0, true);
+    if (pending->mask & IPF_DELETED)
+    {
+      mutt_set_flag(m, e, MUTT_DELETE, (pending->values & IPF_DELETED) != 0, true);
+      e->purge = pending->purge;
+    }
+  }
+  ARRAY_FREE(&mdata->pending_flags);
+  mdata->pending_uidvalidity = 0;
+}
