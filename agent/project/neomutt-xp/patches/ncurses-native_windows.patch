+/* Alternate console buffers retain their old geometry when inactive.
+ * Carry the current viewport to the destination before switching to/from an
+ * editor or helper, preserving the normal buffer's scrollback allocation. */
+static void
+sync_buffer_geometry(HANDLE source, HANDLE target, bool program)
+{
+    CONSOLE_SCREEN_BUFFER_INFO from, to;
+    if (!GetConsoleScreenBufferInfo(source, &from) ||
+        !GetConsoleScreenBufferInfo(target, &to)) return;
+    SHORT width = (SHORT) (from.srWindow.Right - from.srWindow.Left + 1);
+    SHORT height = (SHORT) (from.srWindow.Bottom - from.srWindow.Top + 1);
+    if (width <= 0 || height <= 0) return;
+    SMALL_RECT small = { 0, 0,
+        (SHORT) ((width < to.dwSize.X ? width : to.dwSize.X) - 1),
+        (SHORT) ((height < to.dwSize.Y ? height : to.dwSize.Y) - 1) };
+    SetConsoleWindowInfo(target, TRUE, &small);
+    COORD size = { width, program || to.dwSize.Y < height ? height : to.dwSize.Y };
+    SetConsoleScreenBufferSize(target, size);
+    SHORT top = program ? 0 : to.srWindow.Top;
+    if (top > size.Y - height) top = (SHORT) (size.Y - height);
+    SMALL_RECT viewport = { 0, top, (SHORT) (width - 1), (SHORT) (top + height - 1) };
+    SetConsoleWindowInfo(target, TRUE, &viewport);
+}
