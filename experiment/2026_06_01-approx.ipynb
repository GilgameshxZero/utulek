    "for i in range(1, 98):\n",
    "\tdiff = math.floor(50 / 97 * i)\n",
    "\tdiff = min(50 / 97 - diff / i, (diff + 1) / i - 50 / 97)\n",
    "\tdiffs.append((diff, i))\n",
    "diffs = sorted(diffs)"
